---
export const prerender = true

import { createReader } from '@keystatic/core/reader'
import Markdoc from '@markdoc/markdoc'
import keystaticConfig from '../../keystatic.config'
import BaseLayout from '../layouts/BaseLayout.astro'

const reader = createReader(process.cwd(), keystaticConfig)
const schedule = await reader.singletons.schedule.read()

let contentHtml = ''
if (schedule?.content) {
  const { node } = await schedule.content()
  contentHtml = Markdoc.renderers.html(Markdoc.transform(node))
}
---

<BaseLayout title="練習日程">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">練習日程</h1>
  {contentHtml
    ? <div class="prose max-w-none" set:html={contentHtml} />
    : <p class="text-gray-500">現在、練習日程の情報はありません。</p>
  }
</BaseLayout>
