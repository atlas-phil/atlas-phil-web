---
export const prerender = true

import { createReader } from '@keystatic/core/reader'
import keystaticConfig from '../../../keystatic.config'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogCard from '../../components/BlogCard.astro'

export async function getStaticPaths() {
  const categories = ['member-blog', 'concert-report', 'interview'] as const
  return categories.map((category) => ({ params: { category } }))
}

const { category } = Astro.params

const categoryLabels: Record<string, string> = {
  'member-blog': '団員ブログ',
  'concert-report': '本番レポート',
  'interview': '【団員にきいてみた】シリーズ',
}

const reader = createReader(process.cwd(), keystaticConfig)
const allPosts = await reader.collections.posts.all()

const posts = allPosts
  .filter((post) => post.entry.category === category)
  .sort((a, b) => (b.entry.publishedDate ?? '').localeCompare(a.entry.publishedDate ?? ''))
  .map((post) => {
    const date = new Date(post.entry.publishedDate ?? '')
    const year = date.getFullYear()
    const month = String(date.getMonth() + 1).padStart(2, '0')
    const day = String(date.getDate()).padStart(2, '0')
    return { post, href: `/${year}/${month}/${day}/${decodeURIComponent(post.slug)}` }
  })

const pageTitle = categoryLabels[category] ?? category
---

<BaseLayout title={pageTitle}>
  <h1 class="text-2xl font-bold text-gray-800 mb-6">{pageTitle}</h1>
  {posts.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {posts.map(({ post, href }) => (
        <BlogCard
          title={post.entry.title ?? ''}
          publishedDate={new Date(post.entry.publishedDate ?? '')}
          category={post.entry.category ?? 'member-blog'}
          eyecatch={post.entry.eyecatch ?? undefined}
          href={href}
        />
      ))}
    </div>
  ) : (
    <p class="text-gray-500">このカテゴリの記事はまだありません。</p>
  )}
</BaseLayout>
